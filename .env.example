# GitLab Personal Access Token (requires 'api' scope)
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# Set only for a trusted local HTTP GitLab instance; HTTPS is required by default.
# MR_REVIEWER_ALLOW_INSECURE_GITLAB=false

# GitHub Personal Access Token
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (default provider)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Optional provider keys
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...
# GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=your-google-api-key
# KIMI_API_KEY=...
# DEEPSEEK_API_KEY=...

# Ollama host (if using --provider ollama)
# OLLAMA_HOST=http://localhost:11434

# Optional: AI provider (anthropic, openai, xai, google, kimi, deepseek, echo, ollama)
# MR_REVIEWER_PROVIDER=anthropic

# Optional: AI model id
# MR_REVIEWER_MODEL=<provider-model-id>

# Optional: default review focus areas
# MR_REVIEWER_FOCUS=bugs,style,best-practices

# Optional: enable parallel review mode
# MR_REVIEWER_PARALLEL=false

# Optional: minimum changed files to trigger parallel mode
# MR_REVIEWER_PARALLEL_THRESHOLD=10

# Optional: maximum non-critical inline comments
# MR_REVIEWER_MAX_COMMENTS=10
